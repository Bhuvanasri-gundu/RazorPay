# ==================================================
# REVA — Frontend Environment Configuration Example
# ==================================================
# Copy this file to .env.local and fill in your values.
# Only variables safe for browser exposure may be prefixed with NEXT_PUBLIC_.
# NEVER put GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY, or RAZORPAY_KEY_SECRET here.

# Backend API Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Client Configuration (Public anon key safe for browser)
# Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_HERE
